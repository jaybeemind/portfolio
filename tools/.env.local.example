# Copy this file to the repo root as .env.local and fill in the two values.
#
#   copy tools\.env.local.example .env.local     (Windows)
#   cp tools/.env.local.example .env.local       (bash)
#
# .env.local is gitignored. Do not commit it, and do not paste these values
# into a chat window or a commit message.

ROOC_USER=you@example.com
ROOC_PASS=your-password
